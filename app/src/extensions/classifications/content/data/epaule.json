        {
          "id": "neer_coiffe",
          "title": "Classification de NEER (stades)",
          "images": [],
          "blocks": [
            {
              "type": "item",
              "label": "Stade I",
              "bullets": [
                "Tendinite aigue < 25 ans",
                "Tendinopathies hémorragiques avec œdème",
                "Lésions réversibles"
              ]
            },
            {
              "type": "item",
              "label": "Stade II",
              "text": "Tendinopathie chronique (25-40 ans)",
              "bullets": [
                "Evolution fibreuse de la bourse qui s'épaissit et devient fibreuse",
                "Lésions irréversibles"
              ]
            },
            {
              "type": "item",
              "label": "Stade III",
              "text": "Rupture de la CR > 40 ans",
              "bullets": [
                "Les ruptures partielles peuvent être supérieures en regard de la bourse sous acromiale, inférieure sur la face antérieure ou même intra tendineuse"
              ]
            }
          ]
        },
        {
          "id": "classification_de_goutallier_arthroscanner",
          "title": "Classification de GOUTALLIER (Arthroscanner)",
          "images": [],
          "blocks": [
            {
              "type": "item",
              "label": "Stade « 0 »",
              "text": "Pas de graisse"
            },
            {
              "type": "item",
              "label": "Stade « 1 »",
              "text": "Quelques dépôts de graisse"
            },
            {
              "type": "item",
              "label": "Stade « 2 »",
              "text": "Moins de graisse que de muscle"
            },
            {
              "type": "item",
              "label": "Stade « 3 »",
              "text": "Autant de graisse que de muscle"
            },
            {
              "type": "item",
              "label": "Stade « 4 »",
              "text": "Plus de graisse que de muscle"
            }
          ]
        },
        {
