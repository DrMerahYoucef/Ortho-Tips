            {
              "type": "item",
              "label": "III",
              "text": "Stade II + fermeture ostéophytique des défilés sus et sous épineux"
            }
          ]
        },
        {
          "id": "bernageau_arthrographie",
          "title": "BERNAGEAU (Arthrographie)",
          "images": [],
          "blocks": [
            {
              "type": "item",
              "label": "Stade 1",
              "text": "Le fragment proximal dépasse en dehors le pôle supérieur de la tête humérale"
            },
            {
              "type": "item",
              "label": "Stade 2",
              "text": "Le moignon tendineux est situé en regard du pôle supérieur de la tête humérale"
            },
            {
              "type": "item",
              "label": "Stade 3",
              "text": "Le moignon tendineux est situé en regard de l'interligne gléno huméral"
            }
          ]
        },
        {
          "id": "classification_proposee_par_zlatkin_irm",
          "title": "Classification proposée par ZLATKIN (IRM)",
          "images": [],
          "blocks": [
            {
              "type": "item",
              "label": "Grade 0",
              "text": "Tendon présentant un hyposignal normal et une morphologie normale"
            },
            {
              "type": "item",
              "label": "Grade 1",
              "text": "Hyposignal diffus intratendineux"
            },
            {
              "type": "item",
              "label": "Grade 2",
              "text": "Tendon avec hyposignal et modification morphologique ; subdivisé en grade 2A et grade 2B en fonction de la sévérité des modifications morphologiques"
            },
            {
              "type": "item",
              "label": "Grade 3",
              "text": "Tendon présentant un rehaussement du signal en T2 au sein d'un defect tendineux ; cet hypersignal doit être identique à celui du liquide éventuellement présent dans l'articulation"
            }
          ]
        }
      ]
