          "blocks": [
            {
              "type": "item",
              "label": "Grade « 0 »",
              "text": "Pas de rupture"
            },
            {
              "type": "item",
              "label": "Grade « 1 »",
              "text": "Éraillure tendineuse sans rupture"
            },
            {
              "type": "item",
              "label": "Grade « 2 »",
              "text": "Rupture partielle"
            },
            {
              "type": "item",
              "label": "Grade « 3 »",
