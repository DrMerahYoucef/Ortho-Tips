          "images": [],
          "blocks": [
            {
              "type": "item",
              "label": "I",
              "text": "Rupture du cintre omo huméral"
            },
            {
              "type": "item",
              "label": "II",
              "text": "Arthrose acromio trochitérienne et gléno humérale avec usure du pôle supérieur de la glène"
