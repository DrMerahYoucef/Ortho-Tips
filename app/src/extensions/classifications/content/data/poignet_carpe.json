            {
              "type": "item",
              "label": "Type I",
              "bullets": [
                "PSD serrée",
                "Stable +++",
                "Pas d'arthrose (longtemps supportée)"
              ]
            },
            {
              "type": "item",
              "label": "Type II",
              "bullets": [
                "Résorption osseuse des 2 fragments",
                "PSD lâche, visualisation du reste du trait",
                "Stabilité précaire +++",
                "Évolution ± rapide vers conflit stylo-scaphoïdien"
              ]
            },
            {
              "type": "item",
              "label": "Type III",
              "bullets": [
                "Large perte de substance : néo articulation",
                "Instabilité complète +++",
                "Évolution rapide vers l'arthrose généralisée"
              ]
            },
            {
              "type": "item",
              "label": "Type IV",
              "bullets": [
                "Nécrose"
              ]
            }
          ]
        },
        {
          "id": "classification_d_alnot",
          "title": "Classification d'ALNOT",
          "images": [],
          "blocks": [
            {
              "type": "item",
              "label": "Type I",
              "bullets": [
                "PSD linéaire stable serrée",
                "Pas de modification de la forme du scaphoïde",
                "Pas d'instabilité du carpe"
              ]
            },
            {
              "type": "item",
              "label": "Type II A",
              "bullets": [
                "PSD stable serrée",
                "Géodes et résorption osseuse",
                "Peu de modification de la forme du scaphoïde",
                "Pas d'instabilité ni désaxation",
                "Styloïde effilée"
              ]
            },
            {
              "type": "item",
              "label": "Type II B",
              "bullets": [
                "PSD ± mobile ± lâche",
                "Géode et résorption osseuse",
                "Modification de la forme du scaphoïde",
                "Instabilité et adaptation osseuse ou ligamentaire",
                "Arthrose scapho-styloïdienne débutante"
              ]
            },
            {
              "type": "item",
              "label": "Type III (PSD déplacée + instabilité de désaxation réductible ou ± fixe)",
              "sub": [
                {
                  "label": "III A",
                  "bullets": [
                    "+ arthrose scapho-radiale +++"
                  ]
                },
                {
                  "label": "III B",
                  "bullets": [
                    "Arthrose globale radio-carpienne +++ et intra carpienne +++"
                  ]
                }
              ]
            },
            {
              "type": "item",
              "label": "Type IV (nécrose du fragment proximal)",
              "sub": [
                {
                  "label": "IV A",
                  "bullets": [
                    "+ Désaxation"
                  ]
                },
                {
                  "label": "IV B",
                  "bullets": [
                    "+ arthrose radio scaphoïdienne + radio carpienne + inter carpienne"
                  ]
                }
              ]
            }
          ]
        },
