            {
              "type": "item",
              "label": "Type II",
              "text": "Luxation irréductible sans fracture de la tête ou de l'acétabulum"
            },
            {
              "type": "item",
              "label": "Type III",
              "text": "Hanche instable après réduction ou incarcération intra articulaire"
