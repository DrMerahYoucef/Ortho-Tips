    {
      "id": "luxation_traumatique_de_la_hanche",
      "title": "Luxation traumatique de la hanche",
      "classifications": [
        {
          "id": "classification_de_bigelow",
          "title": "Classification de BIGELOW",
          "images": [],
          "blocks": [
            {
              "type": "item",
              "label": "1. Luxations régulières",
              "text": "Caractérisées par l'intégrité du ligament de Bertin, on décrit 02 variétés"
            },
            {
              "type": "item",
              "label": "Luxation postérieure 75%",
              "bullets": [
                "Lux postéro-sup (haute), iliaque : la tête fémorale en arrière au-dessus du cotyle (extension)",
                "Lux postéro-inf (basse), ischiatique : la tête en arrière, et au-dessous du cotyle (flexion)"
              ]
            },
            {
              "type": "item",
              "label": "Luxation antérieure 25%",
              "bullets": [
                "Lux antéro-inf (obturatrice) : la tête fémorale en avant et au-dessous du cotyle",
                "Lux antéro-sup (pubienne) : la tête en avant et au-dessus du cotyle"
              ]
            },
            {
              "type": "item",
              "label": "2. Luxations irrégulières",
              "text": "Le ligament de Bertin est rompu, ce qui autorise des déplacements importants"
            },
            {
              "type": "item",
              "label": "Sus cotyloïdienne",
              "bullets": [
                "Antérieure oblique",
                "Postérieure haute",
                "Sus pubienne"
              ]
            },
            {
              "type": "item",
              "label": "Sous cotyloïdienne",
              "bullets": [
                "Périnéale",
                "Sous ischiatique"
              ]
            }
          ]
        },
        {
          "id": "classification_de_levin_stabilite_et_caractere_pur_ou_associe_de_la_luxation",
