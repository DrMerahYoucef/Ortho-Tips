    {
      "id": "fracture_du_col_du_femur",
      "title": "Fracture du col du fémur",
      "classifications": [
        {
          "id": "classification_de_garden_basee_sur_le_deplacement_des_travees_de_la_tete",
          "title": "Classification de GARDEN (basée sur le déplacement des travées de la tête)",
          "images": [
            "images/col_femur_garden_type1.png",
            "images/col_femur_garden_type2.png",
            "images/col_femur_garden_type3.png",
            "images/col_femur_garden_type4.png"
          ],
          "blocks": [
            {
              "type": "item",
              "label": "Type I",
              "text": "FR incomplet en COXA VALGA",
              "bullets": [
                "Travées céphaliques verticalisées avec un angle > 160°",
                "Elle est engrenée pouvant se désengrener",
                "Bon pronostic, risque de PSD et nécrose de la tête minime"
              ]
            },
            {
              "type": "item",
              "label": "Type II",
              "text": "FR complète sans déplacement",
              "bullets": [
                "Travées brisées mais non déplacées",
                "Bon pronostic"
              ]
            },
            {
              "type": "item",
              "label": "Type III",
              "text": "FR complète en COXA VARA",
              "bullets": [
                "Les travées céphaliques brisées sont déplacées en COXA VARA (horizontalisées)",
                "Le fragment distal est en rotation externe",
                "Les fragments restent solidaires par une charnière postéro inf qui est la synoviale",
                "La synoviale déchirée en avant seulement"
              ]
            },
            {
              "type": "item",
              "label": "Type IV",
              "text": "FR complète avec déplacement total",
              "bullets": [
                "Les 02 fragments sont désolidarisés",
                "Les travées brisées, avec direction presque normale mais les travées céphaliques sont décalées en dedans par rapport aux travées cervicales",
                "Synoviale complètement déchirée",
                "Risque de nécrose de la tête majeur"
              ]
            }
          ]
        },
        {
          "id": "classification_de_delbet_basee_sur_le_siege_du_trait_de_fracture",
