        {
          "id": "les_stades_de_croisement_de_la_dysplasie_trochleenne_radiologique",
          "title": "Les stades de croisement de la dysplasie trochléenne (radiologique)",
          "images": [],
          "blocks": [
            {
              "type": "table",
              "headers": [
                "Type",
                "Description"
              ],
              "rows": [
                [
                  "Trochlée type I",
                  "Le croisement se fait au même endroit sur les 2 condyles et tout au sommet de la trochlée — Forme la moins grave"
                ],
                [
                  "Trochlée type II",
                  "Le croisement se fait à une hauteur différente sur les 2 condyles — Pronostic favorable"
                ],
                [
                  "Trochlée type III",
                  "Le croisement se fait sur les 2 condyles au même niveau mais à 1 ou 2 cm plus bas du sommet de la trochlée — Signifie que la trochlée est plate — Forme la plus grave"
                ]
              ]
            }
          ]
        },
        {
