        {
          "id": "classification_de_nordin",
          "title": "Classification de NORDIN",
          "images": [],
          "blocks": [
            {
              "type": "item",
              "label": "Type I",
              "text": "FR condylienne post",
              "bullets": [
                "Assimilable à une FR de HOFFA dont le trait frontal passe en arrière du plan vertical passant par le tubercule sus condylien",
                "Le fragment détaché est libre de toute insertion capsulo ligamentaire",
                "Le déplacement est très important, ascension et bascule qui peut atteindre 90°"
              ]
            },
            {
              "type": "item",
              "label": "Type II",
              "text": "FR condylienne intermédiaire",
              "bullets": [
                "Trait plus oblique s'étendant de la sinus condylo-trochléenne jusqu'à la région supra condylienne",
                "Le fragment détaché demeure solidarisé partiellement par le LLI pour le condyle interne, et le LCA et tendon du muscle poplité pour le condyle externe"
              ]
            },
            {
              "type": "item",
              "label": "Type III",
              "text": "FR trochléo-condylienne ant",
              "bullets": [
                "Trait oblique, s'étend de l'échancrure inter condylienne à la région sus condyle ext",
                "Le fragment détaché demeure solidarisé des formations capsulo-ligamentaires post et du LCA-LCP"
              ]
            },
            {
              "type": "item",
              "label": "Type IV",
              "text": "FR trochléo-condylienne sagittale",
              "bullets": [
                "FR assimilable à la FR de TRELAT",
                "Le trait post de l'échancrure inter condylienne s'étend vers la métaphyse et diaphyse"
              ]
            }
          ]
        },
