        {
          "id": "classification_d_utheza_fractures_thalamiques_avec_enfoncement",
          "title": "Classification d'UTHEZA (fractures thalamiques avec enfoncement)",
          "images": [],
          "blocks": [
            {
              "type": "item",
              "label": "",
              "bullets": [
                "Le trait de séparation de Palmer est toujours sagittal, trait fondamental"
              ]
            },
            {
              "type": "item",
              "label": "Fracture verticale",
              "bullets": [
                "Le trait fondamental est plutôt médial",
                "Le fragment cortico-thalamique prédominant est le siège d'un enfoncement vertical",
                "Ce type de fracture se produirait lorsque le pied est en pronation au moment de la chute"
              ]
            },
            {
              "type": "item",
              "label": "Fractures horizontales",
              "bullets": [
                "Le trait fondamental est plutôt latéral",
                "Le fragment antéro-médial prédominant est le siège d'un enfoncement horizontal",
                "Ce type de fracture se produirait lorsque le pied est en supination au moment de la chute"
              ]
            },
            {
              "type": "item",
              "label": "Fractures mixtes",
              "bullets": [
                "Le trait fondamental est médio-thalamique",
                "Le fragment antéro-médial est enfoncé horizontalement (abaissement)",
                "Le fragment cortico-thalamique est enfoncé verticalement (pivotement)",
                "Ce type de fracture se produirait lorsque le pied est en position indifférente lors de la chute"
              ]
            }
          ]
        }
      ]
