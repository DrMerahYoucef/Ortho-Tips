                  ]
                },
                {
                  "label": "III b",
                  "bullets": [
                    "Large perte de substance cutanée + abrasion périostée exposant le foyer à une contamination massive"
                  ]
                },
                {
                  "label": "III c",
                  "bullets": [
                    "Lésion vasculaire"
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "classification_de_duparc_pour_les_lesions_osseuses",
          "title": "Classification de DUPARC pour les lésions osseuses",
          "images": [],
          "blocks": [
            {
              "type": "item",
              "label": "Type I",
              "bullets": [
