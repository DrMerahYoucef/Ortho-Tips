        {
          "id": "classification_de_cauchoix_et_duparc",
          "title": "Classification de CAUCHOIX ET DUPARC",
          "images": [],
          "blocks": [
            {
              "type": "item",
              "label": "",
              "bullets": [
                "Plaie ponctiforme ou linéaire franche"
              ]
            },
            {
              "type": "item",
              "label": "Type I",
              "bullets": [
                "Sans décollement ni contusion",
                "Saigne bien, parée par excision économique",
                "Suturable sans tension",
                "Pronostic comparable à celui d'une FR fermée"
              ]
            },
            {
              "type": "item",
              "label": "Type II",
              "bullets": [
                "Plaie large à bord contus",
                "Tissu graisseux sous cutané dévitalisé",
                "Suturable sous tension",
                "Exposant au risque de nécrose secondaire (picot)"
              ],
              "sub": [
                {
                  "label": "II a",
                  "bullets": [
                    "Plaie délimitant des lambeaux de vitalité douteuse"
                  ]
                },
                {
                  "label": "II b",
                  "bullets": [
                    "Plaie avec décollement sous aponévrotique pré tibial, avec zone de peau contuse et nécrotique"
                  ]
                }
              ]
            },
            {
              "type": "item",
              "label": "Type III",
              "bullets": [
                "Perte de substance cutanée pré tibiale en regard ou à proximité du foyer de FR",
                "Le sont d'emblée ou après excision chirurgicale"
              ],
              "sub": [
                {
                  "label": "III a",
                  "bullets": [
                    "Perte de substance limitée pouvant espérer une réparation dirigée"
                  ]
                },
                {
                  "label": "III b",
                  "bullets": [
                    "Perte de substance étendue sans espoir de cicatrisation dirigée, risque infectieux augmenté"
                  ]
                }
              ]
            },
            {
              "type": "item",
              "label": "",
              "bullets": [
                "Cette classification ne tient pas compte des lésions osseuses et des lésions vasculaires"
              ]
            }
          ]
        },
        {
