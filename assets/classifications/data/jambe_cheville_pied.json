          "images": [],
          "blocks": [
            {
              "type": "item",
              "label": "Type I",
              "text": "Plaie quasi punctiforme de moins de 1 cm"
            },
            {
              "type": "item",
              "label": "Type II",
              "text": "Plaie > 1 cm sans lésion étendue des parties molles"
            },
            {
              "type": "item",
              "label": "Type III",
              "text": "Lésions graves non fermables",
              "sub": [
                {
                  "label": "III a",
                  "bullets": [
